# Set the actual public origin before a production build (no trailing path).
PUBLIC_SITE_URL=
# Official links only. Empty values hide unavailable external destinations.
PUBLIC_GITHUB_URL=
PUBLIC_COMMUNITY_URL=
# GitHub edit URL ending in /vut-web/src/routes (without a trailing slash).
PUBLIC_EDIT_BASE_URL=
# Official logo asset URL or /images/<official-logo-file> copied into static/.
PUBLIC_LOGO_URL=
