# Environment variables and process arguments.
#
# Native access goes through platform primitives that return the shared result
# envelope; this module maps status codes into a typed `EnvError`.
import _internal.abi

@link_name("vut_rt_env_get_v1")
extern "C" fn _native_get(name: str) -> bytes

@link_name("vut_rt_env_has_v1")
extern "C" fn _native_has(name: str) -> usize

@link_name("vut_rt_env_set_v1")
extern "C" fn _native_set(name: str, value: str) -> bytes

@link_name("vut_rt_env_remove_v1")
extern "C" fn _native_remove(name: str) -> bytes

@link_name("vut_rt_env_all_v1")
extern "C" fn _native_all() -> bytes

@link_name("vut_rt_env_args_v1")
extern "C" fn _native_args() -> bytes

fn _get(name: str) -> bytes:
  unsafe:
    _native_get(name)

fn _has(name: str) -> usize:
  unsafe:
    _native_has(name)

fn _set(name: str, value: str) -> bytes:
  unsafe:
    _native_set(name, value)

fn _remove(name: str) -> bytes:
  unsafe:
    _native_remove(name)

fn _all() -> bytes:
  unsafe:
    _native_all()

fn _args() -> bytes:
  unsafe:
    _native_args()

enum EnvErrorKind:
  invalid_name
  invalid_value
  invalid_encoding
  unsupported
  other

data EnvError:
  kind: EnvErrorKind
  message: str

fn _kind(code: int) -> EnvErrorKind:
  if code == 14:
    return EnvErrorKind.invalid_name
  if code == 15:
    return EnvErrorKind.invalid_value
  if code == 11:
    return EnvErrorKind.invalid_encoding
  if code == 8:
    return EnvErrorKind.unsupported
  EnvErrorKind.other

fn _error(raw: bytes) -> EnvError:
  EnvError(kind: _kind(abi.status(raw)), message: abi.message(raw))

fn _completed(raw: bytes) -> result[unit, EnvError]:
  if not abi.is_ok(raw):
    return err(_error(raw))
  ok(unit)

fn get(name: str) -> result[str?, EnvError]:
  raw = _get(name)
  if abi.status(raw) == 1:
    return ok(null)
  if not abi.is_ok(raw):
    return err(_error(raw))
  match abi.payload(raw).to_str():
    ok(text): ok(text)
    err(error): err(EnvError(kind: EnvErrorKind.invalid_encoding, message: "invalid environment encoding"))

# Invalid names are false; malformed values still count as present.
fn has(name: str) -> bool:
  _has(name) != 0

fn set(name: str, value: str) -> result[unit, EnvError]:
  _completed(_set(name, value))

fn remove(name: str) -> result[unit, EnvError]:
  _completed(_remove(name))

fn all() -> result[map[str, str], EnvError]:
  raw = _all()
  if not abi.is_ok(raw):
    return err(_error(raw))
  values: map[str, str] = ()
  fields = abi.fields(raw)
  key = ""
  for value, index in fields:
    if index % 2 == 0:
      key = value
    else:
      values.set(key, value)
  ok(values)

# Includes the executable at argument zero.
fn args() -> list[str]:
  abi.fields(_args())

fn arg(index: usize) -> str?:
  values = args()
  if index >= values.len().to_usize():
    return null
  values.at(index.to_int())
