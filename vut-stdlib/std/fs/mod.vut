# Filesystem access.
#
# Path-based operations return `FsError`; `File` stream methods return
# `io.IoError` so a `File` structurally satisfies `io.Reader`/`io.Writer`.
# Native primitives return the shared result envelope; this module maps status
# codes into typed errors.
#
# Successful operations without a payload return result[unit, FsError].
import _internal.abi
import _internal.count as count
import io
import path
import fs._errors as errors
import fs._metadata as meta

type FsError = errors.FsError
type FsErrorKind = errors.FsErrorKind
type Metadata = meta.Metadata
type Permissions = meta.Permissions

opaque data FileHandle

@link_name("vut_rt_fs_open_v1")
extern "C" fn _native_open(location: str, read: usize, write: usize, append: usize, truncate: usize, create: usize, create_new: usize) -> resource[FileHandle]

@link_name("vut_rt_fs_file_ok_v1")
extern "C" fn _native_file_ok(handle: ptr[FileHandle]) -> usize

@link_name("vut_rt_fs_file_error_v1")
extern "C" fn _native_file_error(handle: ptr[FileHandle]) -> bytes

@link_name("vut_rt_fs_file_read_v1")
extern "C" fn _native_file_read(handle: ptr[FileHandle]) -> bytes

@link_name("vut_rt_fs_file_write_v2")
extern "C" fn _native_file_write(handle: ptr[FileHandle], blob: bytes) -> resource[count.Handle]

@link_name("vut_rt_fs_file_flush_v1")
extern "C" fn _native_file_flush(handle: ptr[FileHandle]) -> bytes

@link_name("vut_rt_fs_file_sync_v1")
extern "C" fn _native_file_sync(handle: ptr[FileHandle]) -> bytes

