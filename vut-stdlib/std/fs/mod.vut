@link_name("vut_rt_fs_read_v1")
extern "C" fn _native_read(location: str) -> bytes

@link_name("vut_rt_fs_read_str_v1")
extern "C" fn _native_read_str(location: str) -> bytes

@link_name("vut_rt_fs_write_v1")
extern "C" fn _native_write(location: str, blob: bytes) -> bytes

@link_name("vut_rt_fs_write_str_v1")
extern "C" fn _native_write_str(location: str, blob: str) -> bytes

