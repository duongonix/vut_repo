fn _open(location: str, read: usize, write: usize, append: usize, truncate: usize, create: usize, create_new: usize) -> resource[FileHandle]:
  unsafe:
    _native_open(location, read, write, append, truncate, create, create_new)

fn _exists(location: str) -> usize:
  unsafe:
    _native_exists(location)

fn _is_file(location: str) -> usize:
  unsafe:
    _native_is_file(location)

fn _is_dir(location: str) -> usize:
  unsafe:
    _native_is_dir(location)

fn _read(location: str) -> bytes:
  unsafe:
    _native_read(location)

fn _read_str(location: str) -> bytes:
  unsafe:
    _native_read_str(location)

fn _write(location: str, blob: bytes) -> bytes:
  unsafe:
    _native_write(location, blob)

fn _write_str(location: str, blob: str) -> bytes:
  unsafe:
    _native_write_str(location, blob)

fn _append(location: str, blob: bytes) -> bytes:
  unsafe:
    _native_append(location, blob)

fn _append_str(location: str, blob: str) -> bytes:
  unsafe:
    _native_append_str(location, blob)

fn _create_dir(location: str) -> bytes:
  unsafe:
    _native_create_dir(location)

fn _create_dir_all(location: str) -> bytes:
  unsafe:
    _native_create_dir_all(location)

fn _remove_dir(location: str) -> bytes:
  unsafe:
    _native_remove_dir(location)

fn _remove_dir_all(location: str) -> bytes:
  unsafe:
    _native_remove_dir_all(location)

fn _remove_file(location: str) -> bytes:
  unsafe:
    _native_remove_file(location)

fn _copy(from: str, to: str) -> resource[count.Handle]:
  unsafe:
    _native_copy(from, to)

fn _rename(from: str, to: str) -> bytes:
  unsafe:
    _native_rename(from, to)

fn _read_dir(location: str) -> bytes:
  unsafe:
    _native_read_dir(location)

fn _set_readonly(location: str, readonly: usize) -> bytes:
  unsafe:
    _native_set_readonly(location, readonly)

fn _error(code: int, raw: bytes) -> FsError:
  errors.from_status(code, raw)

fn _io_error(code: int, raw: bytes) -> io.IoError:
  io.error_from_status(code, raw)

fn _err_io(code: int, raw: bytes) -> io.IoError:
  _io_error(code, raw)

fn _ok_bytes(value: bytes) -> result[bytes, FsError]:
  ok(value)

fn _err_bytes(code: int, raw: bytes) -> result[bytes, FsError]:
  err(_error(code, raw))

fn _bytes_result(raw: bytes) -> result[bytes, FsError]:
  value: result[bytes, FsError] = if abi.is_ok(raw):
    _ok_bytes(abi.payload(raw))
  else:
    _err_bytes(abi.status(raw), raw)
  value

fn _ok_text(value: str) -> result[str, FsError]:
  ok(value)

fn _err_text(code: int, raw: bytes) -> result[str, FsError]:
  err(_error(code, raw))

fn _text_result(raw: bytes) -> result[str, FsError]:
  value: result[str, FsError] = if abi.is_ok(raw):
    _ok_text(abi.raw_text(raw))
  else:
    _err_text(abi.status(raw), raw)
  value

fn _ok_flag() -> result[unit, FsError]:
  ok(unit)

fn _err_flag(code: int, raw: bytes) -> result[unit, FsError]:
  err(_error(code, raw))

fn _flag_result(raw: bytes) -> result[unit, FsError]:
  value: result[unit, FsError] = if abi.is_ok(raw):
    _ok_flag()
  else:
    _err_flag(abi.status(raw), raw)
  value

fn _ok_list(value: list[DirectoryEntry]) -> result[list[DirectoryEntry], FsError]:
  ok(value)

fn _err_list(code: int, raw: bytes) -> result[list[DirectoryEntry], FsError]:
  err(_error(code, raw))

fn _ok_file(value: File) -> result[File, FsError]:
  ok(value)

fn _err_file(code: int, raw: bytes) -> result[File, FsError]:
  err(_error(code, raw))

fn _ok_io_bytes(value: bytes) -> result[bytes, io.IoError]:
  ok(value)

fn _err_io_bytes(code: int, raw: bytes) -> result[bytes, io.IoError]:
  err(_err_io(code, raw))

fn _io_bytes(raw: bytes) -> result[bytes, io.IoError]:
  value: result[bytes, io.IoError] = if abi.is_ok(raw):
    _ok_io_bytes(abi.payload(raw))
  else:
    _err_io_bytes(abi.status(raw), raw)
  value

fn _ok_io_flag() -> result[unit, io.IoError]:
  ok(unit)

fn _err_io_flag(code: int, raw: bytes) -> result[unit, io.IoError]:
  err(_err_io(code, raw))

fn _io_flag(raw: bytes) -> result[unit, io.IoError]:
  value: result[unit, io.IoError] = if abi.is_ok(raw):
    _ok_io_flag()
  else:
    _err_io_flag(abi.status(raw), raw)
  value

data DirectoryEntry:
  _name: str
  _path: str

fn DirectoryEntry.name() -> str:
  self._name

fn DirectoryEntry.path() -> str:
  self._path

fn DirectoryEntry.is_file() -> bool:
  is_file(self._path)

fn DirectoryEntry.is_dir() -> bool:
  is_dir(self._path)

fn DirectoryEntry.metadata() -> result[Metadata, FsError]:
  metadata(self._path)

# ---- File / OpenOptions ----

data File:
  _handle: resource[FileHandle]
  _path: str

static fn File.open(location: str) -> result[File, FsError]:
  options = OpenOptions(read: true)
  options.open(location)

static fn File.create(location: str) -> result[File, FsError]:
  options = OpenOptions(write: true, create: true, truncate: true)
  options.open(location)

fn File.path() -> str:
  self._path

fn File.metadata() -> result[Metadata, FsError]:
  unsafe:
    meta.decode(_native_file_metadata(self._handle))

fn File.read() -> result[bytes, io.IoError]:
  unsafe:
    return _io_bytes(_native_file_read(self._handle))

fn File.write(blob: bytes) -> result[usize, io.IoError]:
  unsafe:
    return io.size_from_native(_native_file_write(self._handle, blob))

fn File.flush() -> result[unit, io.IoError]:
  unsafe:
    return _io_flag(_native_file_flush(self._handle))

fn File.sync() -> result[unit, io.IoError]:
  unsafe:
    return _io_flag(_native_file_sync(self._handle))

data OpenOptions:
  read: bool = false
  write: bool = false
  append: bool = false
  truncate: bool = false
  create: bool = false
  create_new: bool = false

fn _flag(value: bool) -> usize:
  if value:
    return 1
  return 0

fn OpenOptions.open(location: str) -> result[File, FsError]:
  handle = _open(location, _flag(self.read), _flag(self.write), _flag(self.append), _flag(self.truncate), _flag(self.create), _flag(self.create_new))
  valid: usize = 0
  unsafe:
    valid = _native_file_ok(handle)
  if valid == 0:
    raw: bytes = bytes()
    unsafe:
      raw = _native_file_error(handle)
    return _err_file(abi.status(raw), raw)
  _ok_file(File(_handle: handle, _path: location))

# ---- Path-based operations ----

fn exists(location: str) -> bool:
  _exists(location) != 0

fn is_file(location: str) -> bool:
  _is_file(location) != 0

fn is_dir(location: str) -> bool:
  _is_dir(location) != 0

fn read(location: str) -> result[bytes, FsError]:
  _bytes_result(_read(location))

fn read_str(location: str) -> result[str, FsError]:
  _text_result(_read_str(location))

# Creates the file if absent and truncates it if present.
fn write(location: str, blob: bytes) -> result[unit, FsError]:
  _flag_result(_write(location, blob))

fn write_str(location: str, blob: str) -> result[unit, FsError]:
  _flag_result(_write_str(location, blob))

# Creates the file if absent; appends otherwise.
fn append(location: str, blob: bytes) -> result[unit, FsError]:
  _flag_result(_append(location, blob))

fn append_str(location: str, blob: str) -> result[unit, FsError]:
  _flag_result(_append_str(location, blob))

fn create_dir(location: str) -> result[unit, FsError]:
  _flag_result(_create_dir(location))

fn create_dir_all(location: str) -> result[unit, FsError]:
  _flag_result(_create_dir_all(location))

fn remove_dir(location: str) -> result[unit, FsError]:
  _flag_result(_remove_dir(location))

fn remove_dir_all(location: str) -> result[unit, FsError]:
  _flag_result(_remove_dir_all(location))

fn remove_file(location: str) -> result[unit, FsError]:
  _flag_result(_remove_file(location))

fn copy(from: str, to: str) -> result[u64, FsError]:
  handle = _copy(from, to)
  unsafe:
    valid = count.valid(handle)
    raw = count.error(handle)
    size = count.value(handle)
    if valid == 0:
      return err(_error(abi.status(raw), raw))
    ok(size)

fn rename(from: str, to: str) -> result[unit, FsError]:
  _flag_result(_rename(from, to))

fn read_dir(location: str) -> result[list[DirectoryEntry], FsError]:
  raw = _read_dir(location)
  value: result[list[DirectoryEntry], FsError] = if abi.is_ok(raw):
    entries: list[DirectoryEntry] = @[]
    for name in abi.fields(raw):
      entries.push(DirectoryEntry(_name: name, _path: path.join(location, name)))
    _ok_list(entries)
  else:
    _err_list(abi.status(raw), raw)
  value

fn metadata(location: str) -> result[Metadata, FsError]:
  meta.read(location)

fn permissions(location: str) -> result[Permissions, FsError]:
  information = metadata(location)?
  ok(information.permissions())

fn set_permissions(location: str, permissions: Permissions) -> result[unit, FsError]:
  flag = _flag(permissions.readonly())
  _flag_result(_set_readonly(location, flag))
