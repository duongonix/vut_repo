# Filesystem operations.
#
# Native primitives return the shared result envelope; this module maps status
# codes into a typed `FsError`. `read_dir` yields entry names (relative to the
# directory) sorted lexicographically.
import _internal.abi

@link_name("vut_rt_fs_exists_v1")
extern "C" fn _native_exists(path: str) -> usize

@link_name("vut_rt_fs_is_file_v1")
extern "C" fn _native_is_file(path: str) -> usize

@link_name("vut_rt_fs_is_dir_v1")
extern "C" fn _native_is_dir(path: str) -> usize

@link_name("vut_rt_fs_read_v1")
extern "C" fn _native_read(path: str) -> bytes

@link_name("vut_rt_fs_read_str_v1")
extern "C" fn _native_read_str(path: str) -> bytes

@link_name("vut_rt_fs_write_v1")
extern "C" fn _native_write(path: str, blob: bytes) -> bytes

@link_name("vut_rt_fs_write_str_v1")
extern "C" fn _native_write_str(path: str, blob: str) -> bytes

@link_name("vut_rt_fs_append_v1")
extern "C" fn _native_append(path: str, blob: bytes) -> bytes

@link_name("vut_rt_fs_append_str_v1")
extern "C" fn _native_append_str(path: str, blob: str) -> bytes

@link_name("vut_rt_fs_create_dir_v1")
extern "C" fn _native_create_dir(path: str) -> bytes

@link_name("vut_rt_fs_create_dir_all_v1")
extern "C" fn _native_create_dir_all(path: str) -> bytes

