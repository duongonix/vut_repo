# Operating-system information.
#
# Pure high-level API; native access is limited to platform primitives.
#
# v1 models `OsError` as a stable integer code so error payloads stay free of
# managed fields; `os.message(error)` produces deterministic human-readable
# text. The code registry is fixed and versioned with the stdlib.
import _internal.abi

@link_name("vut_rt_os_name_v1")
extern "C" fn _native_name() -> str

@link_name("vut_rt_os_arch_v1")
extern "C" fn _native_arch() -> str

@link_name("vut_rt_os_family_v1")
extern "C" fn _native_family() -> str

@link_name("vut_rt_os_home_dir_v1")
extern "C" fn _native_home_dir() -> bytes

@link_name("vut_rt_os_temp_dir_v1")
extern "C" fn _native_temp_dir() -> bytes

@link_name("vut_rt_os_current_dir_v1")
extern "C" fn _native_current_dir() -> bytes

@link_name("vut_rt_os_set_current_dir_v1")
extern "C" fn _native_set_current_dir(path: str) -> bytes

@link_name("vut_rt_os_current_exe_v1")
extern "C" fn _native_current_exe() -> bytes

@link_name("vut_rt_os_cpu_count_v1")
extern "C" fn _native_cpu_count() -> usize

# Stable error codes shared across modules.
type OsError = int

fn message(error: OsError) -> str:
  text: str = if error == 1:
    "not found"
  elif error == 2:
    "permission denied"
  elif error == 3:
    "already exists"
  elif error == 4:
    "invalid input"
  elif error == 11:
    "invalid data"
  elif error == 8:
    "unsupported operation"
  else:
    "native operation failed"
  text

fn _ok_text(text: str) -> result(str, OsError):
  ok(text)

fn _err_text(code: OsError) -> result(str, OsError):
  err(code)

fn _ok_flag() -> result(bool, OsError):
  ok(true)

fn _err_flag(code: OsError) -> result(bool, OsError):
  err(code)

fn _text(raw: bytes) -> result(str, OsError):
  status = abi.status(raw)
  value: result(str, OsError) = if status != 0:
    _err_text(status)
  else:
    match abi.payload(raw).to_str():
      ok(text): _ok_text(text)
      err(error): _err_text(11)
  value

fn _set_result(raw: bytes) -> result(bool, OsError):
  value: result(bool, OsError) = if abi.is_ok(raw):
    _ok_flag()
  else:
    _err_flag(abi.status(raw))
  value

# Canonical platform name: `windows`, `linux`, or `macos`.
fn name() -> str:
  unsafe:
    _native_name()

# Canonical architecture name, e.g. `x86_64` or `aarch64`.
fn arch() -> str:
  unsafe:
    _native_arch()

# Broad platform family: `windows` or `unix`.
fn family() -> str:
  unsafe:
    _native_family()

fn home_dir() -> result(str, OsError):
  unsafe:
    _text(_native_home_dir())

fn temp_dir() -> result(str, OsError):
  unsafe:
    _text(_native_temp_dir())

fn current_dir() -> result(str, OsError):
  unsafe:
    _text(_native_current_dir())

fn current_exe() -> result(str, OsError):
  unsafe:
    _text(_native_current_exe())

fn set_current_dir(path: str) -> result(bool, OsError):
  unsafe:
    _set_result(_native_set_current_dir(path))

fn cpu_count() -> usize:
  unsafe:
    _native_cpu_count()
