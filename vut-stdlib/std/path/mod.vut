# Pure lexical path operations; never access the filesystem.
import path._parts as parts

fn separator() -> str:
  parts.separator()

fn is_absolute(value: str) -> bool:
  parsed = parts.parse(value)
  parsed.rooted and (not parts.windows() or not parsed.prefix.is_empty())

fn is_relative(value: str) -> bool:
  not is_absolute(value)

fn components(value: str) -> list[str]:
  parsed = parts.parse(value)
  values: list[str] = @[]
  if not parsed.prefix.is_empty():
    values.push(parsed.prefix)
  if parsed.rooted:
    values.push(separator())
  for part in parsed.values:
    values.push(part)
  values

fn join(base: str, child: str) -> str:
  parsed = parts.parse(child)
  if not parsed.prefix.is_empty():
    return child
  if parsed.rooted:
    owner = parts.parse(base)
    return owner.prefix + parts.render(parsed)
  if base.is_empty():
    return child
  if base.ends_with(separator()) or (parts.windows() and base.ends_with("/")):
    return base + child
  if parts.windows() and base.ends_with(":"):
    return base + child
  base + separator() + child

fn parent(value: str) -> str?:
  parsed = parts.parse(value)
  if parsed.values.is_empty():
    return null
  removed = parsed.values.remove(parsed.values.len() - 1)
  parts.render(parsed)

fn file_name(value: str) -> str?:
  parsed = parts.parse(value)
  if parsed.values.is_empty():
    return null
  name = parsed.values.last()
  if name == "." or name == "..":
    return null
  name

fn _dot(name: str) -> int:
  count = 0
  last = -1
  for piece in name.split("."):
    if count > 0:
      last = count - 1
    count = count + piece.byte_len() + 1
  last

fn extension(value: str) -> str?:
  name = file_name(value)
  if name == null:
    return null
  dot = _dot(name)
  if dot <= 0:
    return null
  name.substring(dot + 1, name.byte_len())

fn stem(value: str) -> str?:
  name = file_name(value)
  if name == null:
    return null
  dot = _dot(name)
  if dot <= 0:
    return name
  name.substring(0, dot)

fn with_extension(value: str, suffix: str) -> str:
  name = file_name(value)
  if name == null:
    return value
  parsed = parts.parse(value)
  dot = _dot(name)
  base = if dot > 0:
    name.substring(0, dot)
  else:
    name
  replacement = if suffix.is_empty():
    base
  else:
    base + "." + suffix
  parsed.values.set(parsed.values.len() - 1, replacement)
  parts.render(parsed)

fn normalize(value: str) -> str:
  parsed = parts.parse(value)
  if parsed.verbatim:
    return value
  kept: list[str] = @[]
  removed = ""
  for part in parsed.values:
    if part == "..":
      if not kept.is_empty() and kept.last() != "..":
        removed = kept.pop()
      elif not parsed.rooted:
        kept.push(part)
    elif part != ".":
      kept.push(part)
  parsed.values = kept
  result = parts.render(parsed)
  if result.is_empty() and not value.is_empty():
    return "."
  result
