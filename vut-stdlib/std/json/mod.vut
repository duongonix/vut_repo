# JSON parsing, serialization, and dynamic values.
#
# Pure high-level implementation over Vut's `bytes`/`str` primitives. The
# dynamic value is a typed recursive enum; recursion goes through `list`/`map`
# so the representation stays finite and obeys the memory model. JSON numbers
# keep integer precision instead of being coerced through `float`.

enum ErrorKind:
  syntax
  unexpected_end
  invalid_utf8
  invalid_escape
  invalid_number
  number_overflow
  type_mismatch
  missing_field
  unknown_field
  invalid_enum
  invalid_length
  unsupported_type
  other

data Error:
  kind: ErrorKind
  message: str
  line: int
  column: int

data EncodeOptions:
  pretty: bool
  indent: int

# Types opt into typed encoding by providing `to_json`. The compiler will
# eventually derive this method for `data`/`enum` types; for now it is written
# explicitly or generated by tooling.
interface Encodable:
  to_json() -> Value

# Types opt into typed decoding by providing a static `from_json`. The
# compiler will eventually derive this for `data`/`enum` types.
interface Decodable:
  static from_json(value: Value) -> result(Self, Error)

enum Number:
  integer(value: int)
  decimal(value: float)

enum Value:
  null_value
  boolean(value: bool)
  number(value: Number)
  string(value: str)
  array(value: list(Value))
  object(value: map(str, Value))

data Parsed:
  value: Value
  next: int

data KeyResult:
  key: str
  next: int

# ---------------------------------------------------------------------------
# Errors
# ---------------------------------------------------------------------------

fn _error(kind: ErrorKind, message: str, line: int, column: int) -> Error:
  Error(kind = kind, message = message, line = line, column = column)

fn _type_error() -> Error:
  _error(ErrorKind.type_mismatch, "JSON value has an unexpected type", 0, 0)

fn _missing_field(key: str) -> Error:
  _error(ErrorKind.missing_field, "missing field `$key`", 0, 0)

fn _line_at(input: bytes, position: int) -> int:
  line = 1
  index = 0
  for:
    if index >= position:
      break
    if _byte(input, index) == 10:
      line = line + 1
    index = index + 1
  line

fn _column_at(input: bytes, position: int) -> int:
  line_start = 0
  index = 0
  for:
    if index >= position:
      break
    if _byte(input, index) == 10:
      line_start = index + 1
    index = index + 1
  position - line_start + 1

fn _syntax(input: bytes, position: int, message: str) -> Error:
  _error(
    ErrorKind.syntax,
    message,
    _line_at(input, position),
    _column_at(input, position)
  )

fn _ok(value: Value, next: int) -> result(Parsed, Error):
  ok(Parsed(value = value, next = next))

fn _fail(error: Error) -> result(Parsed, Error):
  err(error)

fn _ok_value(value: Value) -> result(Value, Error):
  ok(value)

fn _err_value(error: Error) -> result(Value, Error):
  err(error)

# ---------------------------------------------------------------------------
# Bytes helpers
# ---------------------------------------------------------------------------

fn _byte(input: bytes, index: int) -> int:
  input.byte_at(index)

fn _is_digit(byte: int) -> bool:
  byte >= 48 and byte <= 57

fn _is_space(byte: int) -> bool:
  byte == 32 or byte == 9 or byte == 10 or byte == 13

fn _is_hex(byte: int) -> bool:
  _is_digit(byte) or (byte >= 97 and byte <= 102) or (byte >= 65 and byte <= 70)

fn _hex(byte: int) -> int:
  result: int = if byte >= 48 and byte <= 57:
    byte - 48
  elif byte >= 97 and byte <= 102:
    byte - 87
  elif byte >= 65 and byte <= 70:
    byte - 55
  else:
    -1
  result

fn _hex_char(value: int) -> str:
  if value < 10:
    return (48 + value).to_char()
  (87 + value).to_char()

fn _slice_text(input: bytes, start: int, end: int) -> str:
  piece: bytes = input.slice(start, end)
  result: str = match piece.to_str():
    ok(text): text
    err(detail): ""
  result

fn _spaces(count: int) -> str:
  out = ""
  index = 0
  for:
    if index >= count:
      break
    out = out + 32.to_char()
    index = index + 1
  out

fn _skip(input: bytes, position: int) -> int:
  result = position
  for:
    if result >= input.len():
      break
    if _is_space(_byte(input, result)):
      result = result + 1
    else:
      break
  result

# ---------------------------------------------------------------------------
# Parsing
# ---------------------------------------------------------------------------

fn _utf8_len(lead: int) -> int:
  result: int = if lead < 0:
    0
  elif lead < 128:
    1
  elif lead < 224:
    2
  elif lead < 240:
    3
  else:
    4
  result

fn _parse_literal(input: bytes, position: int, expected: str, value: Value) -> result(Parsed, Error):
  end = position + expected.byte_len()
  if end > input.len():
    return _fail(_syntax(input, position, "unexpected end of input"))
  found = _slice_text(input, position, end)
  result: result(Parsed, Error) = if found == expected:
    _ok(value, end)
  else:
    _fail(_syntax(input, position, "invalid literal"))
  result

fn _parse_string(input: bytes, position: int) -> result(Parsed, Error):
  text = ""
  pos = position + 1
  closed = false
  failed = ""
  for:
    if pos >= input.len():
      break
    byte = _byte(input, pos)
    if byte == 34:
      pos = pos + 1
      closed = true
      break
    if byte < 32:
      failed = "control character in string"
      break
    if byte != 92:
      width = _utf8_len(byte)
      if width == 0:
        failed = "invalid UTF-8 in string"
        break
      text = text + _slice_text(input, pos, pos + width)
      pos = pos + width
    else:
      if pos + 1 >= input.len():
        failed = "unterminated escape"
        break
      escape = _byte(input, pos + 1)
      if escape == 117:
        if pos + 5 >= input.len():
          failed = "invalid unicode escape"
          break
        code = _hex(_byte(input, pos + 2)) * 4096 + _hex(_byte(input, pos + 3)) * 256 + _hex(_byte(input, pos + 4)) * 16 + _hex(_byte(input, pos + 5))
        if code < 0:
          failed = "invalid unicode escape"
          break
        pos = pos + 6
        if code >= 55296 and code <= 56319 and pos + 5 < input.len() and _byte(input, pos) == 92 and _byte(input, pos + 1) == 117:
          low = _hex(_byte(input, pos + 2)) * 4096 + _hex(_byte(input, pos + 3)) * 256 + _hex(_byte(input, pos + 4)) * 16 + _hex(_byte(input, pos + 5))
          if low >= 56320 and low <= 57343:
            code = 65536 + (code - 55296) * 1024 + (low - 56320)
            pos = pos + 6
        text = text + code.to_char()
      else:
        text = text + _escape_byte(escape)
        pos = pos + 2
  result: result(Parsed, Error) = if failed != "":
    _fail(_syntax(input, position, failed))
  elif not closed:
    _fail(_syntax(input, position, "unterminated string"))
  else:
    _ok(Value.string(value = text), pos)
  result

fn _escape_byte(byte: int) -> str:
  result: str = if byte == 34:
    34.to_char()
  elif byte == 92:
    92.to_char()
  elif byte == 47:
    47.to_char()
  elif byte == 98:
    8.to_char()
  elif byte == 102:
    12.to_char()
  elif byte == 110:
    10.to_char()
  elif byte == 114:
    13.to_char()
  elif byte == 116:
    9.to_char()
  else:
    ""
  result

fn _scan_digits(input: bytes, position: int) -> int:
  result = position
  for:
    if not _is_digit(_byte(input, result)):
      break
    result = result + 1
  result

fn _ok_int(value: int) -> result(int, Error):
  ok(value)

fn _err_int(error: Error) -> result(int, Error):
  err(error)

fn _parse_int(input: bytes, start: int, end: int) -> result(int, Error):
  negative = _byte(input, start) == 45
  pos = if negative:
    start + 1
  else:
    start
  limit = 922337203685477580
  accumulator = 0
  overflow = false
  minimum = false
  for:
    if pos >= end:
      break
    digit = _byte(input, pos) - 48
    if accumulator < limit or (accumulator == limit and digit <= 7):
      accumulator = accumulator * 10 + digit
      pos = pos + 1
    elif negative and accumulator == limit and digit == 8 and pos + 1 == end:
      minimum = true
      pos = pos + 1
    else:
      overflow = true
      break
  if overflow:
    return _err_int(_syntax(input, start, "integer is out of range"))
  if minimum:
    return _ok_int((0 - limit) * 10 - 8)
  if negative:
    return _ok_int(0 - accumulator)
  _ok_int(accumulator)

fn _parse_number(input: bytes, position: int) -> result(Parsed, Error):
  pos = position
  if _byte(input, pos) == 45:
    pos = pos + 1
  byte = _byte(input, pos)
  if byte == 48:
    pos = pos + 1
  elif byte >= 49 and byte <= 57:
    pos = _scan_digits(input, pos)
  else:
    return _fail(_syntax(input, position, "invalid number"))
  integer_end = pos
  decimal = false
  if _byte(input, pos) == 46:
    decimal = true
    pos = pos + 1
    if not _is_digit(_byte(input, pos)):
      return _fail(_syntax(input, position, "invalid fraction"))
    pos = _scan_digits(input, pos)
  if _byte(input, pos) == 101 or _byte(input, pos) == 69:
    decimal = true
    pos = pos + 1
    if _byte(input, pos) == 43 or _byte(input, pos) == 45:
      pos = pos + 1
    if not _is_digit(_byte(input, pos)):
      return _fail(_syntax(input, position, "invalid exponent"))
    pos = _scan_digits(input, pos)
  result: result(Parsed, Error) = if decimal:
    text = _slice_text(input, position, pos)
    _ok(Value.number(value = Number.decimal(value = text.to_f64())), pos)
  else:
    _integer_result(input, position, integer_end, pos)
  result

fn _integer_result(input: bytes, start: int, end: int, pos: int) -> result(Parsed, Error):
  parsed = _parse_int(input, start, end)
  result: result(Parsed, Error) = match parsed:
    ok(value): _ok(Value.number(value = Number.integer(value = value)), pos)
    err(error): err(error)
  result

fn _parse_value(input: bytes, position: int, depth: int) -> result(Parsed, Error):
  if depth > 128:
    return _fail(_syntax(input, position, "maximum nesting depth exceeded"))
  pos = _skip(input, position)
  if pos >= input.len():
    return _fail(_syntax(input, pos, "unexpected end of input"))
  byte = _byte(input, pos)
  result: result(Parsed, Error) = if byte == 110:
    _parse_literal(input, pos, "null", Value.null_value)
  elif byte == 116:
    _parse_literal(input, pos, "true", Value.boolean(value = true))
  elif byte == 102:
    _parse_literal(input, pos, "false", Value.boolean(value = false))
  elif byte == 34:
    _parse_string(input, pos)
  elif byte == 91:
    _array_begin(input, pos, depth)
  elif byte == 123:
    _object_begin(input, pos, depth)
  elif byte == 45 or _is_digit(byte):
    _parse_number(input, pos)
  else:
    _fail(_syntax(input, pos, "expected a JSON value"))
  result

fn _array_begin(input: bytes, position: int, depth: int) -> result(Parsed, Error):
  pos = _skip(input, position + 1)
  if _byte(input, pos) == 93:
    return _ok(Value.array(value = @()), pos + 1)
  _array_from(input, pos, depth, @())

fn _array_from(input: bytes, position: int, depth: int, items: list(Value)) -> result(Parsed, Error):
  parsed = _parse_value(input, position, depth + 1)
  result: result(Parsed, Error) = match parsed:
    ok(entry): _array_sep(input, entry.next, depth, _push(items, entry.value))
    err(error): err(error)
  result

fn _push(items: list(Value), value: Value) -> list(Value):
  items.push(value)
  items

fn _array_sep(input: bytes, position: int, depth: int, items: list(Value)) -> result(Parsed, Error):
  pos = _skip(input, position)
  result: result(Parsed, Error) = if _byte(input, pos) == 44:
    _array_from(input, _skip(input, pos + 1), depth, items)
  elif _byte(input, pos) == 93:
    _ok(Value.array(value = items), pos + 1)
  else:
    _fail(_syntax(input, pos, "expected `,` or `]`"))
  result

fn _read_key(input: bytes, position: int) -> result(KeyResult, Error):
  parsed = _parse_string(input, position)
  result: result(KeyResult, Error) = match parsed:
    ok(entry): _key_result(entry.value, entry.next, input, position)
    err(error): err(error)
  result

fn _key_result(value: Value, next: int, input: bytes, position: int) -> result(KeyResult, Error):
  result: result(KeyResult, Error) = match value:
    string(text): ok(KeyResult(key = text, next = next))
    _: err(_syntax(input, position, "expected object key"))
  result

fn _object_begin(input: bytes, position: int, depth: int) -> result(Parsed, Error):
  pos = _skip(input, position + 1)
  if _byte(input, pos) == 125:
    return _ok(Value.object(value = map()), pos + 1)
  _object_from(input, pos, depth, map())

fn _object_from(input: bytes, position: int, depth: int, entries: map(str, Value)) -> result(Parsed, Error):
  key = _read_key(input, _skip(input, position))
  result: result(Parsed, Error) = match key:
    ok(entry): _object_value(input, _skip(input, entry.next), depth, entries, entry.key)
    err(error): err(error)
  result

fn _put(entries: map(str, Value), key: str, value: Value) -> map(str, Value):
  entries.set(key, value)
  entries

fn _object_value(input: bytes, position: int, depth: int, entries: map(str, Value), key: str) -> result(Parsed, Error):
  if _byte(input, position) != 58:
    return _fail(_syntax(input, position, "expected `:`"))
  value = _parse_value(input, _skip(input, position + 1), depth + 1)
  result: result(Parsed, Error) = match value:
    ok(entry): _object_sep(input, entry.next, depth, _put(entries, key, entry.value))
    err(error): err(error)
  result

fn _object_sep(input: bytes, position: int, depth: int, entries: map(str, Value)) -> result(Parsed, Error):
  pos = _skip(input, position)
  result: result(Parsed, Error) = if _byte(input, pos) == 44:
    _object_from(input, pos + 1, depth, entries)
  elif _byte(input, pos) == 125:
    _ok(Value.object(value = entries), pos + 1)
  else:
    _fail(_syntax(input, pos, "expected `,` or `}`"))
  result

fn parse(input: str) -> result(Value, Error):
  parse_bytes(input.to_bytes())

fn parse_bytes(input: bytes) -> result(Value, Error):
  utf8 = input.to_str()
  result: result(Value, Error) = match utf8:
    ok(text): _parse_document(input)
    err(detail): err(_error(ErrorKind.invalid_utf8, "input is not valid UTF-8", 1, 1))
  result

fn _parse_document(input: bytes) -> result(Value, Error):
  parsed = _parse_value(input, 0, 0)
  result: result(Value, Error) = match parsed:
    ok(entry): _trailing(input, entry)
    err(error): err(error)
  result

fn _trailing(input: bytes, entry: Parsed) -> result(Value, Error):
  trailing = _skip(input, entry.next)
  if trailing == input.len():
    return _ok_value(entry.value)
  _err_value(_syntax(input, trailing, "trailing characters after JSON value"))

# ---------------------------------------------------------------------------
# Dynamic access
# ---------------------------------------------------------------------------

fn Value.is_null() -> bool:
  match self:
    null_value: true
    _: false

fn Value.is_bool() -> bool:
  match self:
    boolean(inner): true
    _: false

fn Value.is_number() -> bool:
  match self:
    number(inner): true
    _: false

fn Value.is_str() -> bool:
  match self:
    string(inner): true
    _: false

fn Value.is_array() -> bool:
  match self:
    array(inner): true
    _: false

fn Value.is_object() -> bool:
  match self:
    object(inner): true
    _: false

fn Value.as_bool() -> result(bool, Error):
  result: result(bool, Error) = match self:
    boolean(inner): ok(inner)
    _: err(_type_error())
  result

fn Value.as_int() -> result(int, Error):
  result: result(int, Error) = match self:
    number(inner): inner.as_int()
    _: err(_type_error())
  result

fn Value.as_float() -> result(float, Error):
  result: result(float, Error) = match self:
    number(inner): inner.as_float()
    _: err(_type_error())
  result

fn Value.as_str() -> result(str, Error):
  result: result(str, Error) = match self:
    string(inner): ok(inner)
    _: err(_type_error())
  result

fn Value.as_array() -> result(list(Value), Error):
  result: result(list(Value), Error) = match self:
    array(inner): ok(inner)
    _: err(_type_error())
  result

fn Value.as_object() -> result(map(str, Value), Error):
  result: result(map(str, Value), Error) = match self:
    object(inner): ok(inner)
    _: err(_type_error())
  result

fn Number.as_int() -> result(int, Error):
  result: result(int, Error) = match self:
    integer(inner): ok(inner)
    decimal(inner): err(_error(ErrorKind.type_mismatch, "number is not an integer", 0, 0))
  result

fn Number.as_float() -> result(float, Error):
  result: result(float, Error) = match self:
    integer(inner): ok(inner.to_float())
    decimal(inner): ok(inner)
  result

fn Value.len() -> int:
  result: int = match self:
    string(inner): inner.char_len()
    array(inner): inner.len()
    object(inner): inner.len()
    _: 0
  result

fn Value.is_empty() -> bool:
  self.len() == 0

fn Value.contains(key: str) -> bool:
  result: bool = match self:
    object(entries): entries.contains_key(key)
    _: false
  result

fn Value.get(key: str) -> result(Value, Error):
  result: result(Value, Error) = match self:
    object(entries): _object_lookup(entries, key)
    _: err(_type_error())
  result

fn _object_lookup(entries: map(str, Value), key: str) -> result(Value, Error):
  if entries.contains_key(key):
    found: Value? = entries.get(key)
    if found != null:
      return _ok_value(found)
  _err_value(_missing_field(key))

fn Value.keys() -> result(list(str), Error):
  result: result(list(str), Error) = match self:
    object(entries): ok(entries.keys())
    _: err(_type_error())
  result

fn Value.at(index: int) -> result(Value, Error):
  result: result(Value, Error) = match self:
    array(items): _array_lookup(items, index)
    _: err(_type_error())
  result

fn _array_lookup(items: list(Value), index: int) -> result(Value, Error):
  if index >= 0 and index < items.len():
    return _ok_value(items.at(index))
  _err_value(_error(ErrorKind.invalid_length, "array index is out of range", 0, 0))

# ---------------------------------------------------------------------------
# Serialization
# ---------------------------------------------------------------------------

fn Value.to_str() -> str:
  stringify(self)

# ---------------------------------------------------------------------------
# Dynamic value construction
# ---------------------------------------------------------------------------
#
# Enum variants are not constructible across module boundaries, so these
# helpers build `Value`s for typed serialization.

fn value_null() -> Value:
  Value.null_value

fn value_bool(value: bool) -> Value:
  Value.boolean(value = value)

fn value_int(value: int) -> Value:
  Value.number(value = Number.integer(value = value))

fn value_float(value: float) -> Value:
  Value.number(value = Number.decimal(value = value))

fn value_str(value: str) -> Value:
  Value.string(value = value)

fn value_array(value: list(Value)) -> Value:
  Value.array(value = value)

fn value_object(value: map(str, Value)) -> Value:
  Value.object(value = value)

# ---------------------------------------------------------------------------
# Typed encoding
# ---------------------------------------------------------------------------

fn encode(value: Encodable) -> str:
  stringify(value.to_json())

fn encode_pretty(value: Encodable) -> str:
  stringify_pretty(value.to_json())

# ---------------------------------------------------------------------------
# Typed decoding
# ---------------------------------------------------------------------------

fn decode(T: Decodable)(source: str) -> result(T, Error):
  match parse(source):
    ok(value): T.from_json(value)
    err(error): err(error)

fn decode_bytes(T: Decodable)(input: bytes) -> result(T, Error):
  match parse_bytes(input):
    ok(value): T.from_json(value)
    err(error): err(error)

fn stringify(value: Value) -> str:
  _write(value, false, 0, 0)

fn stringify_pretty(value: Value) -> str:
  _write(value, true, 2, 0)

fn stringify_with(value: Value, options: EncodeOptions) -> str:
  _write(value, options.pretty, options.indent, 0)

fn _write(value: Value, pretty: bool, indent: int, depth: int) -> str:
  result: str = match value:
    null_value: "null"
    boolean(inner): _write_bool(inner)
    number(inner): _write_number(inner)
    string(inner): _write_string(inner)
    array(items): _write_array(items, pretty, indent, depth)
    object(entries): _write_object(entries, pretty, indent, depth)
  result

fn _write_bool(value: bool) -> str:
  if value:
    return "true"
  "false"

fn _write_number(value: Number) -> str:
  result: str = match value:
    integer(inner): inner.to_str()
    decimal(inner): inner.to_str()
  result

fn _newline_indent(indent: int, depth: int) -> str:
  10.to_char() + _spaces(indent * depth)

fn _write_array(items: list(Value), pretty: bool, indent: int, depth: int) -> str:
  out = "["
  index = 0
  for item in items:
    if index > 0:
      out = out + ","
    if pretty:
      out = out + _newline_indent(indent, depth + 1)
    out = out + _write(item, pretty, indent, depth + 1)
    index = index + 1
  if pretty and index > 0:
    out = out + _newline_indent(indent, depth)
  out + "]"

fn _write_object(entries: map(str, Value), pretty: bool, indent: int, depth: int) -> str:
  keys = entries.keys()
  out = "{"
  index = 0
  for key in keys:
    if index > 0:
      out = out + ","
    if pretty:
      out = out + _newline_indent(indent, depth + 1)
    out = out + _write_string(key)
    if pretty:
      out = out + ":"
      out = out + 32.to_char()
    else:
      out = out + ":"
    entry: Value? = entries.get(key)
    if entry != null:
      out = out + _write(entry, pretty, indent, depth + 1)
    index = index + 1
  if pretty and index > 0:
    out = out + _newline_indent(indent, depth)
  out + "}"

fn _write_string(value: str) -> str:
  raw: bytes = value.to_bytes()
  out = 34.to_char()
  run = 0
  index = 0
  for:
    if index >= raw.len():
      break
    byte = _byte(raw, index)
    if byte == 34 or byte == 92 or byte < 32:
      if index > run:
        out = out + _slice_text(raw, run, index)
      out = out + _write_escape(byte)
      index = index + 1
      run = index
    else:
      index = index + 1
  if index > run:
    out = out + _slice_text(raw, run, index)
  out + 34.to_char()

fn _write_escape(byte: int) -> str:
  result: str = if byte == 34:
    92.to_char() + 34.to_char()
  elif byte == 92:
    92.to_char() + 92.to_char()
  elif byte == 8:
    92.to_char() + 98.to_char()
  elif byte == 12:
    92.to_char() + 102.to_char()
  elif byte == 10:
    92.to_char() + 110.to_char()
  elif byte == 13:
    92.to_char() + 114.to_char()
  elif byte == 9:
    92.to_char() + 116.to_char()
  else:
    92.to_char() + 117.to_char() + 48.to_char() + 48.to_char() + _hex_char(byte / 16) + _hex_char(byte % 16)
  result
