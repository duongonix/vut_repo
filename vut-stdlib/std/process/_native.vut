# Versioned native declarations; resources borrow only at extern pointer parameters.
import _internal.count as count

opaque data ChildHandle
opaque data ReplyHandle
opaque data PipeHandle

@link_name("vut_rt_process_command_spawn_v1")
extern "C" fn command_spawn(program: str, args: list[str], environment: list[str], removed: list[str], cwd: str, stdin: usize, stdout: usize, stderr: usize) -> resource[ChildHandle]

@link_name("vut_rt_process_command_status_v1")
