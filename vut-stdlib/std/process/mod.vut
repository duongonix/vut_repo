# Synchronous-first command builder. Process lifetime is independent of Child.
import process._native as native
import process._reply as reply
import process._child as child

type ProcessError = reply.ProcessError
type ProcessErrorKind = reply.ProcessErrorKind
type ExitStatus = reply.ExitStatus
type Output = reply.Output
type Child = child.Child
type ChildStdin = child.ChildStdin
type ChildStdout = child.ChildStdout
type ChildStderr = child.ChildStderr

enum Stdio:
  inherit
  null_device
  piped

fn _mode(mode: Stdio) -> usize:
  match mode:
    inherit: 0
    null_device: 1
    piped: 2

data Command:
  program: str
  _arguments: list[str] = @[]
  _environment: list[str] = @[]
  _removed: list[str] = @[]
  _cwd: str = ""
  _stdin: usize = 3
  _stdout: usize = 3
  _stderr: usize = 3

fn Command.arg(value: str):
  self._arguments.push(value)

fn Command.args(values: list[str]):
  for value in values:
    self._arguments.push(value)

fn Command.env(name: str, value: str):
  retained: list[str] = @[]
  for key in self._removed:
    if key != name:
      retained.push(key)
  self._removed = retained
  self._environment.push(name)
  self._environment.push(value)

fn Command.env_remove(name: str):
  retained: list[str] = @[]
  keep = false
  for value, index in self._environment:
    if index % 2 == 0:
      keep = value != name
    if keep:
      retained.push(value)
  self._environment = retained
  self._removed.push(name)

fn Command.current_dir(location: str):
  self._cwd = location

fn Command.stdin(mode: Stdio):
  self._stdin = _mode(mode)

fn Command.stdout(mode: Stdio):
  self._stdout = _mode(mode)

fn Command.stderr(mode: Stdio):
  self._stderr = _mode(mode)

fn Command.spawn() -> result[Child, ProcessError]:
  unsafe:
    child.opened(native.command_spawn(self.program, self._arguments, self._environment, self._removed, self._cwd, self._stdin, self._stdout, self._stderr))

fn Command.status() -> result[ExitStatus, ProcessError]:
  unsafe:
    reply.status(native.command_status(self.program, self._arguments, self._environment, self._removed, self._cwd, self._stdin, self._stdout, self._stderr))

fn Command.output() -> result[Output, ProcessError]:
  unsafe:
    reply.output(native.command_output(self.program, self._arguments, self._environment, self._removed, self._cwd, self._stdin, self._stdout, self._stderr))

fn id() -> u32:
  unsafe:
    native.id()

# Explicit exit skips normal deterministic cleanup.
fn exit(code: i32):
  unsafe:
    native.exit(code)

fn status(program: str, args: list[str], cwd: str) -> result[ExitStatus, ProcessError]:
  command = Command(program: program)
  command.args(args)
  command.current_dir(cwd)
  command.status()

fn output(program: str, args: list[str], cwd: str) -> result[Output, ProcessError]:
  command = Command(program: program)
  command.args(args)
  command.current_dir(cwd)
  command.output()
