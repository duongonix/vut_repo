# Common synchronous I/O abstractions.
#
# `bytes` is immutable/COW, so a `Reader` cannot fill a caller-provided buffer.
# Adapted to the ownership model (specs/std/std.md §3.2): `Reader.read()` returns
# a bounded chunk of bytes from the stream, and an empty result means end of
# input. Callers that need exact or line-oriented reads use `BufferedReader`.
#
# Native primitives only provide raw stream chunk read / write / flush; all
# higher-level behavior (read_all, copy, buffering, line splitting) lives here.
import _internal.abi
import _internal.count as count

@link_name("vut_rt_io_stdin_read_v1")
extern "C" fn _native_stdin_read() -> bytes

@link_name("vut_rt_io_stdout_write_v2")
extern "C" fn _native_stdout_write(blob: bytes) -> resource[count.Handle]

@link_name("vut_rt_io_stderr_write_v2")
extern "C" fn _native_stderr_write(blob: bytes) -> resource[count.Handle]

@link_name("vut_rt_io_flush_v1")
extern "C" fn _native_flush() -> bytes

fn _stdin_read() -> bytes:
  unsafe:
    _native_stdin_read()

fn _stdout_write(blob: bytes) -> resource[count.Handle]:
  unsafe:
    _native_stdout_write(blob)

fn _stderr_write(blob: bytes) -> resource[count.Handle]:
  unsafe:
    _native_stderr_write(blob)

fn _flush_stream() -> bytes:
  unsafe:
    _native_flush()

enum IoErrorKind:
  interrupted
  unexpected_eof
  invalid_data
  invalid_input
  permission_denied
  broken_pipe
  timed_out
  unsupported
  other

data IoError:
  kind: IoErrorKind
  message: str

fn _kind(code: int) -> IoErrorKind:
  kind: IoErrorKind = if code == 9:
    IoErrorKind.interrupted
  elif code == 10:
    IoErrorKind.unexpected_eof
  elif code == 11:
    IoErrorKind.invalid_data
  elif code == 4:
    IoErrorKind.invalid_input
  elif code == 2:
    IoErrorKind.permission_denied
  elif code == 12:
    IoErrorKind.broken_pipe
  elif code == 13:
    IoErrorKind.timed_out
  elif code == 8:
    IoErrorKind.unsupported
  else:
    IoErrorKind.other
  kind

fn _error(code: int, raw: bytes) -> IoError:
  IoError(kind: _kind(code), message: abi.message(raw))

# Maps a shared native status code to an `IoError`. Used by other stdlib modules
# (fs/process) whose stream types surface failures through `io.Reader`/`Writer`.
fn error_from_status(code: int, raw: bytes) -> IoError:
  _error(code, raw)

fn _ok_bytes(value: bytes) -> result[bytes, IoError]:
  ok(value)

fn _err_bytes(code: int, raw: bytes) -> result[bytes, IoError]:
  err(_error(code, raw))

fn _ok_size(value: usize) -> result[usize, IoError]:
  ok(value)

fn _ok_flag() -> result[unit, IoError]:
  ok(unit)

fn _err_flag(code: int, raw: bytes) -> result[unit, IoError]:
  err(_error(code, raw))

fn _ok_text(value: str) -> result[str, IoError]:
  ok(value)

fn _ok_line(value: str?) -> result[str?, IoError]:
  ok(value)

fn _invalid_utf8() -> IoError:
  IoError(kind: IoErrorKind.invalid_data, message: "invalid UTF-8")

fn _bytes_result(raw: bytes) -> result[bytes, IoError]:
  value: result[bytes, IoError] = if abi.is_ok(raw):
    _ok_bytes(abi.payload(raw))
  else:
    _err_bytes(abi.status(raw), raw)
  value

fn _size_result(handle: resource[count.Handle]) -> result[usize, IoError]:
  unsafe:
    valid = count.valid(handle)
    raw = count.error(handle)
    size = count.value(handle)
    if valid == 0:
      return err(_error(abi.status(raw), raw))
    ok(size.to_usize())

fn _flag_result(raw: bytes) -> result[unit, IoError]:
  value: result[unit, IoError] = if abi.is_ok(raw):
    _ok_flag()
  else:
    _err_flag(abi.status(raw), raw)
  value

# A source of bytes. `read()` returns a bounded chunk; empty means end of input.
fn bytes_from_status(raw: bytes) -> result[bytes, IoError]:
  _bytes_result(raw)

fn size_from_native(handle: resource[count.Handle]) -> result[usize, IoError]:
  _size_result(handle)

fn unit_from_status(raw: bytes) -> result[unit, IoError]:
  _flag_result(raw)

interface Reader:
  read() -> result[bytes, IoError]

# A sink of bytes. `write()` may write fewer bytes than requested.
interface Writer:
  write(blob: bytes) -> result[usize, IoError]
  flush() -> result[unit, IoError]

# ---- Standard streams ----

data Stdin:
  _unit: int = 0

data Stdout:
  _unit: int = 0

data Stderr:
  _unit: int = 0

fn Stdin.read() -> result[bytes, IoError]:
  _bytes_result(_stdin_read())

fn Stdout.write(blob: bytes) -> result[usize, IoError]:
  _size_result(_stdout_write(blob))

fn Stdout.flush() -> result[unit, IoError]:
  _flag_result(_flush_stream())

fn Stderr.write(blob: bytes) -> result[usize, IoError]:
  _size_result(_stderr_write(blob))

fn Stderr.flush() -> result[unit, IoError]:
  _flag_result(_flush_stream())

fn stdin() -> Stdin:
  Stdin()

fn stdout() -> Stdout:
  Stdout()

fn stderr() -> Stderr:
  Stderr()

# ---- Convenience / compatibility ----

# Writes `text` to standard error without a trailing newline.
fn eprint(text: str) -> result[unit, IoError]:
  written = _size_result(_stderr_write(text.to_bytes()))?
  ok(unit)

# Writes `text` followed by a newline to standard error.
fn eprintln(text: str) -> result[unit, IoError]:
  written = _size_result(_stderr_write((text + "\n").to_bytes()))?
  ok(unit)

fn flush() -> result[unit, IoError]:
  _flag_result(_flush_stream())

# ---- Reader helpers ----

# Reads the whole stream into memory.
fn read_all(reader: Reader) -> result[bytes, IoError]:
  accumulated = bytes()
  done = false
  failure: IoError? = null
  for not done and failure == null:
    chunk: bytes = bytes()
    outcome: result[bytes, IoError] = reader.read()
    match outcome:
      ok(blob):
        chunk = blob
      err(error):
        failure = error
    if failure == null:
      if chunk.len() == 0:
        done = true
      else:
        accumulated.extend(chunk)
  if failure != null:
    return err(failure)
  ok(accumulated)

# Reads the whole stream and decodes it as UTF-8.
fn read_to_str(reader: Reader) -> result[str, IoError]:
  value: result[str, IoError] = match read_all(reader):
    ok(blob):
      match blob.to_str():
        ok(text): _ok_text(text)
        err(error): err(_invalid_utf8())
    err(error): err(error)
  value

# Copies every byte from `reader` to `writer`, returning the byte count.
fn copy(reader: Reader, writer: Writer) -> result[u64, IoError]:
  total: u64 = 0
  maximum: u64 = 18446744073709551615
  for:
    chunk = reader.read()?
    if chunk.len() == 0:
      break
    offset: usize = 0
    size = chunk.len().to_usize()
    for offset < size:
      written = writer.write(chunk.slice(offset.to_int(), chunk.len()))?
      if written == 0 or written > size - offset:
        return err(IoError(kind: IoErrorKind.invalid_data, message: "invalid writer byte count"))
      if total > maximum - written.to_u64():
        return err(IoError(kind: IoErrorKind.invalid_data, message: "copy byte count overflow"))
      offset = offset + written
      total = total + written.to_u64()
  ok(total)

fn write_all(writer: Writer, blob: bytes) -> result[unit, IoError]:
  offset: usize = 0
  size = blob.len().to_usize()
  for offset < size:
    written = writer.write(blob.slice(offset.to_int(), blob.len()))?
    if written == 0 or written > size - offset:
      return err(IoError(kind: IoErrorKind.invalid_data, message: "invalid writer byte count"))
    offset = offset + written
  ok(unit)

# ---- Buffered reader ----

data BufferedReader:
  inner: Reader
  buffer: bytes
  finished: bool = false

fn buffered(reader: Reader) -> BufferedReader:
  BufferedReader(inner: reader, buffer: bytes())

fn BufferedReader.read() -> result[bytes, IoError]:
  if self.buffer.len() > 0:
    result_bytes = self.buffer
    self.buffer = bytes()
    return ok(result_bytes)
  if self.finished:
    return ok(bytes())
  outcome: result[bytes, IoError] = self.inner.read()
  value: result[bytes, IoError] = match outcome:
    ok(blob):
      if blob.len() == 0:
        self.finished = true
      ok(blob)
    err(error): err(error)
  value

# Reads exactly `size` bytes; `unexpected_eof` when the stream ends first.
fn BufferedReader.read_exact(size: usize) -> result[bytes, IoError]:
  accumulated = bytes()
  failure: IoError? = null
  for accumulated.len().to_usize() < size and failure == null:
    chunk: bytes = bytes()
    outcome: result[bytes, IoError] = self.read()
    match outcome:
      ok(blob):
        chunk = blob
      err(error):
        failure = error
    if failure == null:
      if chunk.len() == 0:
        failure = IoError(kind: IoErrorKind.unexpected_eof, message: "unexpected end of input")
      else:
        accumulated.extend(chunk)
  if failure != null:
    return err(failure)
  if accumulated.len().to_usize() > size:
    self.buffer = accumulated.slice(size.to_int(), accumulated.len())
    accumulated = accumulated.slice(0, size.to_int())
  ok(accumulated)

fn _find_newline(buffer: bytes) -> int:
  found = -1
  index = 0
  for index < buffer.len():
    if buffer.at(index) == 10:
      found = index
      break
    index = index + 1
  found

# Reads one line, returning `null` at end of input before any character.
# A trailing `\r` (CRLF input) is removed.
fn BufferedReader.read_line() -> result[str?, IoError]:
  searching = true
  failure: IoError? = null
  for searching and failure == null:
    if _find_newline(self.buffer) >= 0 or self.finished:
      searching = false
    else:
      outcome: result[bytes, IoError] = self.inner.read()
      match outcome:
        ok(blob):
          if blob.len() == 0:
            self.finished = true
          else:
            self.buffer.extend(blob)
        err(error):
          failure = error
  if failure != null:
    return err(failure)
  if self.buffer.len() == 0:
    return ok(null)
  newline = _find_newline(self.buffer)
  end = self.buffer.len()
  if newline >= 0:
    end = newline
  line_bytes = self.buffer.slice(0, end)
  if newline >= 0:
    self.buffer = self.buffer.slice(newline + 1, self.buffer.len())
  else:
    self.buffer = bytes()
  if line_bytes.len() > 0 and line_bytes.at(line_bytes.len() - 1) == 13:
    line_bytes = line_bytes.slice(0, line_bytes.len() - 1)
  value: result[str?, IoError] = match line_bytes.to_str():
    ok(text): _ok_line(text)
    err(error): err(_invalid_utf8())
  value

# ---- Buffered writer ----

data BufferedWriter:
  inner: Writer
  buffer: bytes

fn buffered_writer(writer: Writer) -> BufferedWriter:
  BufferedWriter(inner: writer, buffer: bytes())

fn BufferedWriter.write(blob: bytes) -> result[usize, IoError]:
  self.buffer.extend(blob)
  if self.buffer.len() < 8192:
    return _ok_size(blob.len().to_usize())
  flushed: result[unit, IoError] = self.flush()
  value: result[usize, IoError] = match flushed:
    ok(flag): _ok_size(blob.len().to_usize())
    err(error): err(error)
  value

fn BufferedWriter.write_all(blob: bytes) -> result[unit, IoError]:
  value: result[unit, IoError] = match self.write(blob):
    ok(written): _ok_flag()
    err(error): err(error)
  value

fn BufferedWriter.flush() -> result[unit, IoError]:
  for self.buffer.len() > 0:
    written = self.inner.write(self.buffer)?
    if written == 0 or written > self.buffer.len().to_usize():
      return err(IoError(kind: IoErrorKind.invalid_data, message: "invalid writer byte count"))
    self.buffer = self.buffer.slice(written.to_int(), self.buffer.len())
  self.inner.flush()
