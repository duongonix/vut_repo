# Signed nanosecond spans; wall-clock and monotonic readings remain distinct.
import time._native as native
import time._checked as checked
data Duration:
  nanos: i64

data Timestamp:
  nanos: i64

data Instant:
  nanos: i64

fn now() -> Timestamp:
  unsafe:
    Timestamp(nanos: native.now_nanos())

fn instant() -> Instant:
  unsafe:
    Instant(nanos: native.instant_nanos())

fn nanoseconds(count: i64) -> Duration:
  Duration(nanos: count)

fn microseconds(count: i64) -> Duration:
  Duration(nanos: checked.scale(count, 1000))

fn milliseconds(count: i64) -> Duration:
  Duration(nanos: checked.scale(count, 1000000))

fn seconds(count: i64) -> Duration:
  Duration(nanos: checked.scale(count, 1000000000))

fn minutes(count: i64) -> Duration:
  Duration(nanos: checked.scale(count, 60000000000))

fn hours(count: i64) -> Duration:
  Duration(nanos: checked.scale(count, 3600000000000))

fn from_unix_seconds(count: i64) -> Timestamp:
  Timestamp(nanos: checked.scale(count, 1000000000))

fn from_unix_milliseconds(count: i64) -> Timestamp:
  Timestamp(nanos: checked.scale(count, 1000000))

fn sleep(span: Duration):
  unsafe:
    native.sleep_nanos(span.nanos)

fn elapsed(start: Instant, finish: Instant) -> Duration:
  Duration(nanos: checked.subtract(finish.nanos, start.nanos))

fn Duration.as_nanoseconds() -> i64:
  self.nanos

fn Duration.as_microseconds() -> i64:
  self.nanos / 1000

fn Duration.as_milliseconds() -> i64:
  self.nanos / 1000000

fn Duration.as_seconds() -> i64:
  self.nanos / 1000000000

fn Duration.add(other: Duration) -> Duration:
  Duration(nanos: checked.add(self.nanos, other.nanos))

fn Duration.subtract(other: Duration) -> Duration:
  Duration(nanos: checked.subtract(self.nanos, other.nanos))

fn Timestamp.unix_seconds() -> i64:
  self.nanos / 1000000000

fn Timestamp.unix_milliseconds() -> i64:
  self.nanos / 1000000

fn Timestamp.add(span: Duration) -> Timestamp:
  Timestamp(nanos: checked.add(self.nanos, span.nanos))

fn Timestamp.subtract(span: Duration) -> Timestamp:
  Timestamp(nanos: checked.subtract(self.nanos, span.nanos))

fn Timestamp.duration_since(other: Timestamp) -> Duration:
  Duration(nanos: checked.subtract(self.nanos, other.nanos))

fn Instant.elapsed() -> Duration:
  unsafe:
    Duration(nanos: checked.subtract(native.instant_nanos(), self.nanos))
